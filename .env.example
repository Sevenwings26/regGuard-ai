# RegGuard AI Environment Configuration Template
# Copy this file to .env and insert your API credentials

# Provider Selection: meta | ollama | mock | cached
LLM_PROVIDER=meta

# Execution Mode: LIVE | CACHED
REGGUARD_MODE=LIVE

# Meta API Configuration (OpenAI-compatible /chat/completions endpoint)
META_MODEL=muse-spark-1.3
META_BASE_URL=https://api.meta.ai/v1
META_API_KEY=your_meta_api_key_here

# General LLM Fallback Model Name
LLM_MODEL=llama-3.3-70b-instruct

# Local Ollama Configuration
OLLAMA_MODEL=llama3.3:70b
OLLAMA_BASE_URL=http://localhost:11434/v1

# Embedding Models for Hybrid Qdrant Retrieval (Dense + Sparse BM25)
EMBEDDING_DENSE_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_SPARSE_MODEL=Qdrant/bm25
